# `str` gained `<` `<=` `>` `>=` in M2 (code point order), but a container has
# no order at all: only `==` and `!=` are defined for it (DESIGN 4.6).
# milestone: M2
# error: cannot be applied to `list<str>` and `list<str>`

fn main():
    a: list<str> = ["a"]
    b: list<str> = ["b"]
    if a < b:
        print("ordered")

# `sorted` orders a class only through `__lt__` and `__eq__` (declare `Eq` and
# `Ord`, DESIGN 3.11); a class without them has no order.
# milestone: M3
# error: `sorted` cannot order `Point` values
# error: declare `Eq` and `Ord`

class Point(Eq, Hash):
    x: int

fn main():
    ps = [Point(x=1)]
    print(len(sorted(ps)))

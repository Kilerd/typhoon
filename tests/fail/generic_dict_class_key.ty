# A type argument used as a dict key must be hashable; the error names the
# instance it comes from.
# milestone: M3
# error: `Point` cannot be a dict key

class Point:
    x: int

fn count<T>(xs: list<T>) -> dict<T, int>:
    counts: dict<T, int> = {}
    for x in xs:
        counts[x] = counts.get(x, 0) + 1
    return counts

fn main():
    print(len(count([Point(x=1)])))

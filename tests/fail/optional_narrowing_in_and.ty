# Narrowing flows into an `if` body, not across the operands of `and`
# (DESIGN 3.8).
# milestone: M2
# error: `Point | None` may be `None` here

class Point:
    x: float

fn find(flag: bool) -> Point | None:
    if flag:
        return Point(x=1.0)
    return None

fn main():
    p = find(True)
    if p is not None and p.x > 0.0:
        print("positive")

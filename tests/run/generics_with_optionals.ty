# Generics together with `T | None` (DESIGN 3.9, 3.10): a generic function
# returning `T | None` for int, str and class elements, `T` inferred through a
# `T | None` parameter, an optional type argument (`Stack<int | None>`), and
# an instance of a generic class that may be absent (`Box<int> | None`).
# milestone: M3
# expect: 4 None
# expect: a z
# expect: 3
# expect: no point
# expect: 4 -1 x
# expect: 2 None 1
# expect: [1, None] True
# expect: 4
# expect: no box
# expect: True 11
# expect: [1, 3] ["x"]

class Point:
    x: int
    y: int

class Stack<T>:
    items: list<T>

    fn push(self, value: T):
        self.items.append(value)

    fn pop(self) -> T:
        return self.items.pop()

    fn size(self) -> int:
        return len(self.items)

class Box<T>:
    value: T

    fn get(self) -> T:
        return self.value

fn first<T>(xs: list<T>) -> T | None:
    if len(xs) == 0:
        return None
    return xs[0]

# `T` is inferred from an argument of type `T | None` (or a plain `T`).
fn or_else<T>(v: T | None, fallback: T) -> T:
    if v is None:
        return fallback
    return v

fn find_box(n: int) -> Box<int> | None:
    if n > 0:
        return Box(value=n)
    return None

# A comprehension with an `if` clause that narrows `T | None` to `T`.
fn present<T>(xs: list<T | None>) -> list<T>:
    return [x for x in xs if x is not None]

fn main():
    ints: list<int> = [4, 5]
    empty: list<int> = []
    print(first(ints), first(empty))
    print(first(["a", "b"]), first(["z"]))

    p = first([Point(x=1, y=2)])
    if p is not None:
        print(p.x + p.y)
    no_points: list<Point> = []
    if first(no_points) is None:
        print("no point")

    print(or_else(first(ints), 0), or_else(first(empty), -1), or_else("x", "y"))

    s: Stack<int | None> = Stack(items=[])
    s.push(1)
    s.push(None)
    print(s.size(), s.pop(), s.pop())
    t: Stack<int | None> = Stack(items=[1, None])
    print(t.items, t.items == [1, None])

    b = find_box(3)
    if b is not None:
        print(b.get() + 1)
    if find_box(0) is None:
        print("no box")
    nb: Box<int> | None = None
    print(nb is None, or_else(find_box(10), Box(value=0)).get() + 1)

    vals: list<int | None> = [1, None, 3]
    names: list<str | None> = ["x", None]
    print(present(vals), present(names))

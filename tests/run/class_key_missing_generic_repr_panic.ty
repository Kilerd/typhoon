# A missing class key panics with the key's `__repr__` (DESIGN 3.11), also
# for an instance of a generic class whose `__repr__` nothing else calls, so
# that it is only instantiated for the panic message.
# milestone: M3
# expect: 1
# exit: 101
# stderr: key not found: Box(2)

class Box<T>(Eq, Hash):
    item: T

    fn __repr__(self) -> str:
        return f"Box({self.item})"

fn main():
    d: dict<Box<int>, int> = {Box(item=1): 1}
    print(d[Box(item=1)])
    print(d[Box(item=2)])

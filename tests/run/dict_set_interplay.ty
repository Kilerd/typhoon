# dict and set together with the other M3 features: generic functions and a
# generic class over dict<K, V> / set<T> (instantiated at int and str),
# optional values and `get` defaults that are then narrowed, comparison
# chains over lookups, and dict / set comprehensions with filters, nested
# `for` clauses and shadowing.
# milestone: M3
# expect: {3: 3, 1: 1, 2: 1}
# expect: {"b": 2, "a": 1}
# expect: {2, 1} {"x", "y"}
# expect: ["a", "z"] [1, 2]
# expect: a 3
# expect: True
# expect: 7 2
# expect: 32
# expect: True {"ann": 31, "bob": None}
# expect: 20
# expect: True None
# expect: True False
# expect: {"typhoon": 7, "is": 2, "fast": 4}
# expect: {"typhoon", "fast"}
# expect: [(0, 1), (0, 2), (1, 2)]
# expect: {0: 0, 2: 4, 4: 16}
# expect: {7: "typhoon", 2: "is", 4: "fast"}
# expect: {"t", "i", "f"} outer
# expect: {"typhoon": 14, "fast": 8}
# expect: [3, 1, 2]
# expect: {"typhoon": 7.0, "is": 2.0, "fast": 4.0}

fn count<T>(xs: list<T>) -> dict<T, int>:
    counts: dict<T, int> = {}
    for x in xs:
        counts[x] = counts.get(x, 0) + 1
    return counts

fn distinct<T>(xs: list<T>) -> set<T>:
    seen: set<T> = set()
    for x in xs:
        seen.add(x)
    return seen

fn keys_of<K, V>(d: dict<K, V>) -> list<K>:
    return sorted(d.keys())

class Counter<T>:
    counts: dict<T, int>

    fn add(self, x: T):
        self.counts[x] = self.counts.get(x, 0) + 1

    # The most frequent element, the first one seen on a tie.
    fn most(self) -> T | None:
        best: T | None = None
        best_n = 0
        for k in self.counts:
            if self.counts[k] > best_n:
                best = k
                best_n = self.counts[k]
        return best

fn main():
    print(count([3, 1, 3, 2, 3]))
    print(count(["b", "a", "b"]))
    print(distinct([2, 2, 1]), distinct(["x", "y", "x"]))
    print(keys_of({"z": 1, "a": 2}), keys_of({2: "b", 1: "a"}))

    c: Counter<str> = Counter(counts={})
    for w in "a b a c a b".split(" "):
        c.add(w)
    m = c.most()
    if m is not None:
        print(m, c.counts[m])
    nums: Counter<int> = Counter(counts={})
    print(nums.most() is None)
    nums.add(7)
    nums.add(7)
    n = nums.most()
    if n is not None:
        print(n, nums.counts[n])

    # optional values, narrowed after the lookup
    ages: dict<str, int | None> = {"ann": 31, "bob": None}
    a = ages["ann"]
    if a is not None:
        print(a + 1)
    print(ages["bob"] is None, ages)

    # `get` with a `None` default (or none at all) gives an optional
    scores = {"x": 10}
    s = scores.get("x", None)
    t = scores.get("y")
    if s is not None:
        print(s * 2)
    print(t is None, t)

    # comparison chains over lookups
    print(0 < scores["x"] <= 10, 0 < scores.get("y", 0) < 5)

    # dict and set comprehensions
    words = ["typhoon", "is", "fast", "typhoon"]
    lengths = {w: len(w) for w in words}
    print(lengths)
    print({w for w in words if len(w) > 2})
    pairs = {(i, j) for i in range(3) for j in range(3) if i < j}
    print(sorted(pairs))
    squares = {i: i * i for i in range(5) if i % 2 == 0}
    print(squares)
    inverted = {v: k for k in lengths for v in [lengths[k]]}
    print(inverted)

    # a comprehension variable hides an outer local only inside it
    w = "outer"
    firsts = {w[0:1] for w in words}
    print(firsts, w)

    # comprehensions walk dicts and sets too
    doubled = {k: v * 2 for k in lengths for v in [lengths[k]] if v > 2}
    print(doubled)
    print([k for k in {3, 1, 2}])
    as_floats: dict<str, float> = {k: float(lengths[k]) for k in lengths}
    print(as_floats)

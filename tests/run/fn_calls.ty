# Function calls, if/else, bool and float printing.
# milestone: M1
# expect: 5
# expect: True
# expect: False
# expect: 2.5
# expect: 5.0
# expect: bigger

fn add(a: int, b: int) -> int:
    return a + b

fn is_even(n: int) -> bool:
    return n % 2 == 0

fn pick(a: int, b: int) -> str:
    if a > b:
        return "bigger"
    else:
        return "smaller"

fn main():
    print(add(2, 3))
    print(is_even(4))
    print(is_even(7))
    print(5.0 / 2.0)
    print(5.0)
    print(pick(3, 1))

# f-strings (DESIGN 3.7): every supported spec form, literal braces, an empty
# f-string, expressions inside holes, adjacent holes, holes at both ends and
# non-ASCII literal text.
# milestone: M1
# expect: 42
# expect: 3.5
# expect: True
# expect: storm
# expect: int=42 float=3.5 bool=True str=storm
# expect: 42 42
# expect: storm storm
# expect: 4
# expect: 3.50
# expect: 3.500000
# expect: 2.67
# expect: 0.12
# expect: 2
# expect: 2
# expect: -1.2
# expect: 0.3333
# expect: 1
# expect: {}
# expect: {42}
# expect: a{b}c42
# expect:
# expect: no holes at all
# expect: 10 4 21 2 1
# expect: 4 12
# expect: True False False
# expect: 2.333
# expect: 737
# expect: 42 in the middle 42
# expect: storm423.5True
# expect: 台风 42 级
# expect: emoji 🌀 storm 🌀
# expect: π ≈ 3.142

fn double(n: int) -> int:
    return n * 2

fn ratio(a: int, b: int) -> float:
    return float(a) / float(b)

fn main():
    n = 42
    v = 3.5
    flag = True
    s = "storm"

    # One hole of each type, no spec: rendered exactly like print renders it.
    print(f"{n}")
    print(f"{v}")
    print(f"{flag}")
    print(f"{s}")
    print(f"int={n} float={v} bool={flag} str={s}")

    # The :d and :s specs render exactly like no spec at all.
    print(f"{n:d} {n}")
    print(f"{s:s} {s}")

    # Fixed point with 0, 2 and 6 digits.
    print(f"{v:.0f}")
    print(f"{v:.2f}")
    print(f"{v:.6f}")

    # Rounding follows Python: the binary double is rounded, ties to even.
    print(f"{2.675:.2f}")
    print(f"{0.125:.2f}")
    print(f"{1.5:.0f}")
    print(f"{2.5:.0f}")
    print(f"{-1.25:.1f}")
    print(f"{ratio(1, 3):.4f}")
    print(f"{ratio(2, 3):.0f}")

    # Literal braces.
    print(f"{{}}")
    print(f"{{{n}}}")
    print(f"a{{b}}c{n}")

    # An empty f-string, and one that is only literal text.
    print(f"")
    print(f"no holes at all")

    # Arbitrary expressions inside holes.
    a = 7
    b = 3
    print(f"{a + b} {a - b} {a * b} {a // b} {a % b}")
    print(f"{double(2)} {double(double(3))}")
    print(f"{a > b} {a == b} {not flag}")
    print(f"{float(a) / float(b):.3f}")

    # Adjacent holes with no text between them, and a hole at each end.
    print(f"{a}{b}{a}")
    print(f"{n} in the middle {n}")
    print(f"{s}{n:d}{v:.1f}{flag}")

    # Non-ASCII literal text around the holes.
    print(f"台风 {n} 级")
    print(f"emoji 🌀 {s} 🌀")
    print(f"π ≈ {3.14159:.3f}")

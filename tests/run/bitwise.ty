# Bitwise operators on 64-bit two's complement integers: `& | ^ ~`, logical
# left shift and arithmetic right shift (including negative values), shift
# amounts held in variables, Go's rule that a shift of 64 or more yields 0 or
# the sign, and the relative precedence of the bitwise operators.
# milestone: M1
# expect: 8 14 6
# expect: 0 7 7
# expect: 0 -2 -2
# expect: 255 -1 -256
# expect: -8 -3 5
# expect: -1 -6 4 0
# expect: -9223372036854775808
# expect: 9223372036854775807
# expect: 16 15
# expect: -4 -1 -1
# expect: -5
# expect: 4611686018427387904
# expect: -9223372036854775808
# expect: -4611686018427387904
# expect: 32 -32
# expect: -96 -288230376151711744
# expect: 0 0
# expect: 0 -1 -1
# expect: 32
# expect: 10
# expect: 3
# expect: 252
# expect: 3
# expect: 3
# expect: 8 6

MASK: int = 255
MINI: int = -9223372036854775807 - 1

fn shl(a: int, n: int) -> int:
    return a << n

fn shr(a: int, n: int) -> int:
    return a >> n

fn main():
    # `& | ^` on positive values
    print(12 & 10, 12 | 10, 12 ^ 10)
    print(0 & 7, 0 | 7, 0 ^ 7)

    # negative operands are two's complement
    print(-12 & 10, -12 | 10, -12 ^ 10)
    print(-1 & 255, -1 | 255, -1 ^ 255)
    print(-8 & -3, -8 | -3, -8 ^ -3)

    # `~x` is `-x - 1`
    print(~0, ~5, ~-5, ~-1)
    print(~9223372036854775807)
    print(~MINI)

    # shifts, including an arithmetic right shift of a negative number
    print(1 << 4, 255 >> 4)
    print(-8 >> 1, -8 >> 3, -1 >> 40)
    print(-9 >> 1)
    print(1 << 62)
    print(1 << 63)
    print(3 << 62)

    # a shift amount held in a variable
    n = 5
    print(shl(1, n), shr(-1024, n))
    print(shl(-3, n), shr(MINI, n))

    # Go's rule: a shift amount of 64 or more gives 0, or the sign for `>>`
    wide = 64
    huge = 100
    print(shl(1, wide), shl(1, huge))
    print(shr(1024, wide), shr(-1024, wide), shr(-1024, huge))

    # precedence: `~` > `*` > `+` > `<<` > `&` > `^` > `|`
    print(1 << 2 + 3)
    print(6 & 3 | 8)
    print(1 ^ 2 & 3)
    print(~3 & MASK)
    print(1 | 2 ^ 3 & 4)
    print((1 | 2) ^ (3 & 4))
    print(1 << 3 & 8, 2 * 3 & 7)

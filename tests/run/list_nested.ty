# list<list<int>>: a literal of rows, grid[i][j] reads and writes, appending a
# row and appending to a row, the aliasing `row = grid[i]` creates, an empty
# inner row, per-row sums over a ragged grid, and list<list<str>>.
# milestone: M2
# expect: [[1, 2, 3], [4, 5], [6]] 3 3 1
# expect: 1 5 6 6
# expect: [[1, 2, 3], [40, 5], [60]] 40
# expect: [[1, 2, 3], [40, 5], [60], [7, 8]] 4 2
# expect: [1, 2, 3, 99] [1, 2, 3, 99] 4
# expect: 10 [[10, 2, 3, 99], [40, 5], [60], [7, 8]]
# expect: [10, 2, 3, 99, 100] [10, 2, 3, 99, 100] 5
# expect: 6 [] 0
# expect: [5] [[10, 2, 3, 99, 100], [40, 5], [60], [7, 8], [10, 2, 3, 99, 100], [5]]
# expect: 5 214
# expect: 2 45
# expect: 1 60
# expect: 2 15
# expect: 5 214
# expect: 1 5
# expect: 553
# expect: [[1], [1, 2], [1, 2, 3]] 3 10
# expect: [[1, 0], [1, 2], [1, 2, 3]] 2 3
# expect: [["ty", "phoon"], ["a", "b"]] phoon 2
# expect: [["ty", "phoon"], ["a", "b"], ["c"]] 3 c

fn row_sum(row: list<int>) -> int:
    s = 0
    for v in row:
        s = s + v
    return s

fn grid_sum(grid: list<list<int>>) -> int:
    s = 0
    for row in grid:
        s = s + row_sum(row)
    return s

fn main():
    # a literal of rows: len(grid) counts the rows, len(grid[i]) one row
    grid: list<list<int>> = [[1, 2, 3], [4, 5], [6]]
    print(grid, len(grid), len(grid[0]), len(grid[2]))

    # indexing twice reaches an element, negative indices included
    print(grid[0][0], grid[1][1], grid[2][0], grid[-1][-1])

    # writing twice replaces one element of one row
    grid[1][0] = 40
    grid[-1][0] = 60
    print(grid, grid[1][0])

    # a whole row can be appended to the grid
    grid.append([7, 8])
    print(grid, len(grid), len(grid[3]))

    # `row = grid[i]` aliases the row instead of copying it
    row = grid[0]
    row.append(99)
    print(row, grid[0], len(grid[0]))
    row[0] = 10
    print(grid[0][0], grid)

    # appending that same row again puts one list into two slots
    grid.append(row)
    row.append(100)
    print(grid[0], grid[4], len(grid))

    # an empty inner row: `[[1], []]` has nothing to infer from, so the empty
    # row is an annotated local first
    blank: list<int> = []
    grid.append(blank)
    print(len(grid), grid[5], len(grid[5]))
    blank.append(5)
    print(grid[5], grid)

    # the grid is ragged: every row reports its own length and sum
    for r in grid:
        print(len(r), row_sum(r))
    print(grid_sum(grid))

    # rows built one at a time in a loop are independent lists
    tri: list<list<int>> = []
    for i in range(1, 4):
        r2: list<int> = []
        for j in range(i):
            r2.append(j + 1)
        tri.append(r2)
    print(tri, len(tri), grid_sum(tri))
    tri[0].append(0)
    print(tri, len(tri[0]), len(tri[2]))

    # list<list<str>> nests the same way
    words: list<list<str>> = [["ty", "phoon"], ["a"]]
    words[1].append("b")
    print(words, words[0][1], len(words[1]))
    words.append(["c"])
    print(words, len(words), words[-1][0])

# dict and set over every key shape (int, bool, str, tuples with bool and str
# members) and value shape (lists, tuples, class instances), plus slices
# inside f-string holes. Both backends must agree byte for byte.
# milestone: M3
# expect: yp|on|ty
# expect: {"a": [1, 2]} 2
# expect: {True, False} True
# expect: (1.5, False) (0.5, True) (0.5, True) {}
# expect: {("a", True): 11, ("a", False): 2} [(("a", True), 11), (("a", False), 2)]
# expect: 3 1
# expect: 4
# expect: [("a", False), ("a", True)]
# expect: {} 0 []
# expect: éllo wörld w

class P:
    x: int

fn main():
    s = "typhoon"
    print(f"{s[1:3]}|{s[-2:]}|{s[:2]}")

    d: dict<str, list<int>> = {}
    d["a"] = [1]
    d["a"].append(2)
    print(d, len(d["a"]))

    b: set<bool> = {True}
    b.add(False)
    b.add(True)
    print(b, False in b)

    e: dict<int, tuple<float, bool>> = {1: (0.5, True)}
    print(e.get(2, (1.5, False)), e.get(1, (1.5, False)), e.pop(1, (9.0, True)), e)

    m: dict<tuple<str, bool>, int> = {}
    m[("a", True)] = 1
    m[("a", False)] = 2
    m[("a", True)] = m[("a", True)] + 10
    print(m, m.items())

    # class instances are fine as values (only keys need hashing)
    ps: dict<str, P> = {"p": P(x=3)}
    print(ps["p"].x, len(ps))
    for k in ps:
        ps[k].x = ps[k].x + 1
    print(ps["p"].x)

    print(sorted(m))
    empty: dict<str, int> = dict()
    print(empty, len(empty), sorted(empty))

    u = "héllo wörld"
    print(u[1:5], u[-5:], u[6:7])

source: crates/codegen/tests/ir.rs
expression: "ir(\"fn main():\\n    i = 0\\n    while i < 10:\\n        i = i + 1\\n        if i == 3:\\n            continue\\n        if i > 5:\\n            break\\n        print(i)\\n\")"

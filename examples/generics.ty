# Generics: a monomorphized max<T> and a generic Stack<T>.
# expect: 3
# expect: 2.5
# expect: 2
# expect: 2
# expect: 1
# expect: 0
# expect: b

fn max<T>(a: T, b: T) -> T:
    if a > b:
        return a
    return b

class Stack<T>:
    items: list<T>

    fn push(self, value: T):
        self.items.append(value)

    fn pop(self) -> T:
        return self.items.pop()

    fn size(self) -> int:
        return len(self.items)

fn main():
    print(max(1, 3))                # T inferred as int
    print(max<float>(2.5, 1.5))     # explicit instantiation
    s: Stack<int> = Stack(items=[])
    s.push(1)
    s.push(2)
    print(s.size())
    print(s.pop())
    print(s.pop())
    print(s.size())

    names: Stack<str> = Stack(items=[])
    names.push("b")
    print(names.pop())
